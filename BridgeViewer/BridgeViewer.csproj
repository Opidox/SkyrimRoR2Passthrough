<Project Sdk="Microsoft.NET.Sdk">

  <!-- Petite fenêtre de contrôle qui lit le pont en direct (le "faux Skyrim") -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>BridgeViewer</RootNamespace>
  </PropertyGroup>

  <!-- La même description du pont que le mod RoR2 -->
  <ItemGroup>
    <Compile Include="..\Shared\BridgeData.cs" Link="Shared\BridgeData.cs" />
  </ItemGroup>

</Project>
