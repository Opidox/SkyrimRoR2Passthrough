<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tes chemins à toi (fichier non publié sur GitHub) -->
  <Import Project="..\LocalPaths.props" Condition="Exists('..\LocalPaths.props')" />

  <!-- Réglages généraux du mod -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SkyrimRoR2</AssemblyName>
    <RootNamespace>SkyrimRoR2</RootNamespace>
    <LangVersion>latest</LangVersion>

    <!-- Les deux dossiers : le jeu et le profil r2modman. Pour les changer sans toucher à ce fichier,
         crée LocalPaths.props à côté de SkyrimRoR2.slnx (voir LocalPaths.props.example). -->
    <GameDir Condition="'$(GameDir)' == ''">$(MSBuildProgramFiles32)\Steam\steamapps\common\Risk of Rain 2</GameDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(APPDATA)\r2modmanPlus-local\RiskOfRain2\profiles\Passthrough</ProfileDir>
    <ManagedDir>$(GameDir)\Risk of Rain 2_Data\Managed</ManagedDir>
  </PropertyGroup>

  <!-- La description commune du pont (partagée avec la visionneuse) -->
  <ItemGroup>
    <Compile Include="..\Shared\BridgeData.cs" Link="Shared\BridgeData.cs" />
  </ItemGroup>

  <!-- Les briques dont le mod a besoin (on ne les recopie pas, elles sont déjà dans le jeu) -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(ProfileDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(ProfileDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RoR2">
      <HintPath>$(ManagedDir)\RoR2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.AnimationModule">
      <HintPath>$(ManagedDir)\UnityEngine.AnimationModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedDir)\UnityEngine.ImageConversionModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.ParticleSystemModule">
      <HintPath>$(ManagedDir)\UnityEngine.ParticleSystemModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="KinematicCharacterController">
      <HintPath>$(ManagedDir)\KinematicCharacterController.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="com.unity.multiplayer-hlapi.Runtime">
      <HintPath>$(ManagedDir)\com.unity.multiplayer-hlapi.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Après chaque compilation, le mod est copié tout seul dans ton profil r2modman -->
  <Target Name="CopierDansLeProfil" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ProfileDir)\BepInEx\plugins\SkyrimRoR2" />
    <Message Importance="high" Text="==> SkyrimRoR2.dll copie dans le profil Passthrough" />
  </Target>

</Project>
